{
  "kind": "Dashboard",
  "metadata": {
    "name": "project_flavor_usage",
    "createdAt": "2026-05-21T12:34:49.956070473Z",
    "updatedAt": "2026-06-01T12:05:28.149975405Z",
    "version": 3,
    "tags": [
      "flavor",
      "kvm",
      "vmware"
    ],
    "project": "workload-management"
  },
  "spec": {
    "display": {
      "name": "Project Flavor Usage"
    },
    "panels": {
      "0255b3b37dae4998abcbdb9ccad9e76f": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "VMware Flavor Usage per Project"
          },
          "plugin": {
            "kind": "Table",
            "spec": {
              "columnSettings": [
                {
                  "header": "Domain",
                  "name": "domain_name"
                },
                {
                  "enableSorting": true,
                  "header": "Project",
                  "name": "project_name"
                },
                {
                  "enableSorting": true,
                  "header": "Flavor",
                  "name": "flavor_name"
                },
                {
                  "enableSorting": false,
                  "hide": true,
                  "name": "timestamp"
                },
                {
                  "enableSorting": true,
                  "header": "Amount",
                  "name": "value",
                  "sort": "desc"
                },
                {
                  "hide": true,
                  "name": "domain_id"
                },
                {
                  "hide": true,
                  "name": "project_id"
                }
              ],
              "density": "standard",
              "enableFiltering": true
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "sum by (domain_name, domain_id, project_id, project_name, flavor_name) (cortex_vmware_project_instances{flavor_name=~\"$flavor_name\",project_name=~\"$project_name\",domain_name=~\"$domain_name\",availability_zone=~\"$availability_zone\"})"
                  }
                }
              }
            }
          ]
        }
      },
      "166b50060eb440499cc765a7f0a6f942": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Total KVM Flavor Usage"
          },
          "plugin": {
            "kind": "BarChart",
            "spec": {
              "calculation": "last",
              "format": {
                "shortValues": true,
                "unit": "decimal"
              },
              "mode": "value",
              "sort": "desc"
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "topk(30,sort_desc(sum by (flavor_name) (cortex_kvm_project_instances{flavor_name=~\"$flavor_name\",domain_name=~\"$domain_name\",project_name=~\"$project_name\",availability_zone=~\"$availability_zone\"})))",
                    "seriesNameFormat": "{{flavor_name}}"
                  }
                }
              }
            }
          ]
        }
      },
      "213df60fb32749c3ba908dc9cfb49f24": {
