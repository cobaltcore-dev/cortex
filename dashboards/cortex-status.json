      "39fd1bbdff9948e09145ebd8e4c073c8": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "95th percentile response time (success)"
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "mode": "table",
                "position": "bottom",
                "values": [
                  "min",
                  "max",
                  "mean"
                ]
              },
              "thresholds": {
                "steps": [
                  {
                    "color": "#EE6C6C",
                    "value": 5
                  }
                ]
              },
              "yAxis": {
                "format": {
                  "unit": "seconds"
                },
                "label": "",
                "max": 6.5,
                "min": 0,
                "show": true
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "histogram_quantile(0.95, sum(rate(cortex_scheduler_api_request_duration_seconds_bucket{status=~\"2.+\", service=~\"$service\"}[2m])) by (le, method, path, status, error))",
                    "seriesNameFormat": "{{method}} {{path}} {{status}} {{error}}"
                  }
                }
              }
            }
          ]
        }
      },
