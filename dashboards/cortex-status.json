          "display": {
            "name": "CPU Usage"
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "mode": "table",
                "position": "right",
                "values": [
                  "max",
                  "mean",
                  "min"
                ]
              },
              "thresholds": {
                "mode": "percent",
                "steps": [
                  {
                    "value": 60
                  },
                  {
                    "color": "#EE6C6C",
                    "value": 80
                  }
                ]
              },
              "yAxis": {
                "format": {
                  "unit": "percent-decimal"
                },
                "label": "",
                "max": 1,
                "show": true
