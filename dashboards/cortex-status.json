      "06450de87a3b42189edaeaf13a7a08b4": {
        "kind": "Panel",
        "spec": {
          "display": {},
          "plugin": {
            "kind": "Table",
            "spec": {
              "actions": {},
              "columnSettings": [
                {
                  "header": "Datasource",
                  "name": "datasource"
                },
                {
                  "cellSettings": [
                    {
                      "backgroundColor": "#59CC8D",
                      "condition": {
                        "kind": "Value",
                        "spec": {
                          "value": "ready"
                        }
                      },
                      "text": ""
                    },
                    {
                      "backgroundColor": "#EE6C6C",
                      "condition": {
                        "kind": "Regex",
                        "spec": {
                          "expr": ".*"
                        }
                      }
                    }
                  ],
                  "header": "State",
                  "name": "state"
                }
              ],
              "defaultColumnHidden": true,
              "density": "compact",
              "enableFiltering": true
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "cortex_datasource_state{service=~\"$service\"}"
                  }
                }
              }
            }
          ]
        }
      },
      "1238e3de28d9458bb1421b505bbad491": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "All Pods Up?"
          },
          "plugin": {
            "kind": "StatChart",
            "spec": {
              "calculation": "last-number",
              "colorMode": "background_solid",
              "format": {
                "unit": "decimal"
              },
              "legendMode": "on",
              "mappings": [
                {
                  "kind": "Value",
                  "spec": {
                    "result": {
                      "color": "#EE6C6C",
                      "value": " Down"
                    },
                    "value": "0"
                  }
                },
                {
                  "kind": "Value",
                  "spec": {
                    "result": {
                      "color": "#59CC8D",
                      "value": " "
                    },
                    "value": "1"
                  }
                }
              ]
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "datasource": {
                      "kind": "PrometheusDatasource",
                      "name": "thanos-regional-query"
                    },
                    "query": "up{pod=~\"cortex-nova-scheduling-controller-manager.*\", service=~\"$service\"}",
                    "seriesNameFormat": "Cortex Nova Scheduling"
                  }
                }
              }
            },
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "up{pod=~\"cortex-nova-knowledge-controller-manager.*\", service=~\"$service\"}",
                    "seriesNameFormat": "Cortex Nova Knowledge"
                  }
                }
              }
            },
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "up{pod=~\"cortex-manila-scheduling-controller-manager.*\", service=~\"$service\"}",
                    "seriesNameFormat": "Cortex Manila Scheduling"
                  }
                }
              }
            },
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "up{pod=~\"cortex-manila-knowledge-controller-manager.*\", service=~\"$service\"}",
                    "seriesNameFormat": "Cortex Manila Knowledge"
                  }
                }
              }
            }
          ]
        }
      },
