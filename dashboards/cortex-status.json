          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "rate(process_cpu_seconds_total{service=~\"$service\"}[2m])\n  / on(pod) group_left\nkube_pod_container_resource_limits{pod=~\"cortex-.*\", container=\"manager\", resource=\"cpu\"}",
