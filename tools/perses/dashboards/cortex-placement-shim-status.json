  "spec": {
    "display": {
      "name": "Cortex Placement Shim Status"
    },
    "panels": {
      "0_0": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Downstream successful request rate"
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "mode": "table",
                "position": "bottom",
                "values": [
                  "mean",
                  "max",
                  "min"
                ]
              },
              "visual": {
                "areaOpacity": 0.1,
                "connectNulls": false,
                "display": "line",
                "lineWidth": 1
              },
              "yAxis": {
                "format": {
                  "unit": "decimal"
                },
                "min": 0
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "datasource": {
                      "kind": "PrometheusDatasource"
                    },
                    "minStep": "",
                    "query": "sum(rate(cortex_placement_shim_downstream_request_duration_seconds_count{responsecode=~\"2..\"}[2m])) by (method, pattern, responsecode)",
                    "seriesNameFormat": "{{method}} {{pattern}} {{responsecode}}"
                  }
                }
              }
            }
          ]
        }
