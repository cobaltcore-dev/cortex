  "spec": {
    "display": {
      "name": "Cortex Status Global"
    },
    "panels": {
      "2cc67a00b7b04e2193aea3d819c78ecf": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Memory Usage"
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "thresholds": {
                "mode": "percent",
                "steps": [
                  {
                    "value": 60
                  },
                  {
                    "color": "#EE6C6C",
                    "value": 80
                  }
                ]
              },
              "yAxis": {
                "format": {
                  "unit": "percent-decimal"
                },
                "label": "",
                "max": 1,
                "min": 0,
                "show": true
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "process_resident_memory_bytes{service=~\"$service\", pod=~\"cortex-.*\", region=~\"$region\"} / on (pod) group_left ()\nkube_pod_container_resource_limits{resource=\"memory\", container=\"manager\", pod=~\"cortex-.*\", region=~\"$region\"}\n",
                    "seriesNameFormat": "{{region}} | {{pod}} "
                  }
                }
              }
            }
          ]
        }
      },
      "57975062356b4bc6b403c6da7d0fbf40": {
        "kind": "Panel",
        "spec": {
          "display": {},
          "plugin": {
            "kind": "BarChart",
            "spec": {
              "calculation": "last",
              "format": {
                "shortValues": true,
                "unit": "decimal"
              },
              "groupBy": [],
              "isStacked": false,
              "mode": "value",
              "orientation": "horizontal",
              "sort": "desc"
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "sum by (region, kind) (cortex_multicluster_object_count{service=~\"$service\", region=~\"$region\"})",
                    "seriesNameFormat": "{{region}} | {{kind}} "
                  }
                }
              }
            }
          ]
        }
      },
      "99ebeb12b9704329bd2cc0639e8e21da": {
        "kind": "Panel",
        "spec": {
          "display": {},
          "plugin": {
            "kind": "Table",
            "spec": {
              "cellSettings": [],
              "columnSettings": [
                {
                  "align": "left",
                  "dataLink": {
                    "openNewTab": true,
                    "title": "",
                    "url": "https://perses.${__data.fields[\"region\"]}.cloud.sap/projects/workload-management/dashboards/cortex_status?var-service=${__data.fields[\"service\"]}&start=6h&refresh=0s"
                  },
                  "header": "Region",
