            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "min by (region, service) (up{pod=~\"cortex-.*-scheduling-.*\",service=~\"$service\",region=~\"$region\"})",
                    "seriesNameFormat": "Scheduling Up"
                  }
                }
              }
            },
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "min by (region, service) (up{pod=~\"cortex-.*-knowledge-.*\", service=~\"$service\",region=~\"$region\"})",
                    "seriesNameFormat": "Knowledge Up"
                  }
                }
              }
            },
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "count(cortex_pipeline_state{state=\"ready\",service=~\"$service\",region=~\"$region\"}) by (region, service) / count(cortex_pipeline_state{service=~\"$service\",region=~\"$region\"}) by (region, service) and count(cortex_pipeline_state{service=~\"$service\",region=~\"$region\"}) by (region, service) > 0",
                    "seriesNameFormat": "Pipeline"
                  }
                }
              }
            },
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "count(cortex_knowledge_state{state=\"ready\",service=~\"$service\",region=~\"$region\"}) by (region, service) / count(cortex_knowledge_state{service=~\"$service\",region=~\"$region\"}) by (region, service) and count(cortex_knowledge_state{service=~\"$service\",region=~\"$region\"}) by (region, service) > 0",
                    "seriesNameFormat": "Knowledge"
                  }
                }
              }
            },
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "count(cortex_datasource_state{state=\"ready\",service=~\"$service\",region=~\"$region\"}) by (region, service) / count(cortex_datasource_state{service=~\"$service\",region=~\"$region\"}) by (region, service) and count(cortex_datasource_state{service=~\"$service\",region=~\"$region\"}) by (region, service) > 0",
                    "seriesNameFormat": "Datasource"
                  }
                }
              }
            },
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "count by (region, service) (cortex_kpi_state{state=\"ready\", service=~\"$service\",region=~\"$region\"}) / count by (region, service) (cortex_kpi_state{service=~\"$service\",region=~\"$region\"}) and count(cortex_kpi_state{service=~\"$service\",region=~\"$region\"}) by (region, service) > 0",
                    "seriesNameFormat": "KPI"
                  }
                }
              }
            },
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "sum by (region, service) (\n  process_resident_memory_bytes{service=~\"$service\", pod=~\"cortex-.*-scheduling-.*\",region=~\"$region\"}\n    / on (pod) group_left ()\n  kube_pod_container_resource_limits{resource=\"memory\", container=\"manager\", pod=~\"cortex-.*-scheduling-.*\",region=~\"$region\"}\n)"
                  }
                }
              }
            },
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "sum by (region, service) (\n  process_resident_memory_bytes{service=~\"$service\", pod=~\"cortex-.*-knowledge-.*\",region=~\"$region\"}\n    / on (pod) group_left ()\n  kube_pod_container_resource_limits{resource=\"memory\", container=\"manager\", pod=~\"cortex-.*-knowledge-.*\",region=~\"$region\"}\n)",
                    "seriesNameFormat": "Mem. Knowledge"
                  }
                }
              }
            }
          ]
